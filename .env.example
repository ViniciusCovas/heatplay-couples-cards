# Public frontend configuration. Copy to an untracked .env.local or configure
# the hosting environment. Vite embeds every VITE_ value in browser assets.
# Use the target project's canonical URL from Supabase Settings > API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Public sb_publishable_ key (recommended), or legacy anon JWT during migration.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Recommended deployment guard: the same project ref as the URL above.
# Omit this guard only for local development against localhost/127.0.0.1.
VITE_SUPABASE_PROJECT_ID=

# Isolated editorial review: no online auth, database connection or checkout.
# Keep true until the connected two-phone game has passed its launch checks.
VITE_TABLE_PREVIEW=true

# SERVER SECRETS NEVER BELONG IN VITE_ VARIABLES OR THIS FRONTEND FILE.
# Configure SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY, OPENAI_API_KEY,
# STRIPE_SECRET_KEY and webhook secrets only in the appropriate server runtime.
# A public key does not grant safety by itself: protect data with auth and RLS.
